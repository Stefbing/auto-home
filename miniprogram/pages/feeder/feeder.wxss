page {
  background: #f4f7fb;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-card,
.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 36rpx rgba(20, 40, 80, 0.06);
}

.hero-card {
  margin-bottom: 24rpx;
  padding: 34rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef5ff 100%);
}

.hero-label {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(44, 110, 240, 0.12);
  color: #2c6ef0;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #132238;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #66788f;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
}

.highlight-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff8ee 100%);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #162436;
}

.card-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7b8ba0;
}

.pill-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #ef8d22;
  font-size: 22rpx;
  font-weight: 700;
}

.primary-action {
  margin-top: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #2c6ef0 0%, #5a8dff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-action::after,
.ghost-action::after {
  border: none;
}

.primary-action[disabled],
.ghost-action[disabled] {
  opacity: 0.86;
}

.plan-skeleton {
  margin-top: 10rpx;
}

.skeleton-item,
.plan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf1f5;
}

.skeleton-item:last-child,
.plan-item:last-child {
  border-bottom: none;
}

.skeleton-main {
  flex: 1;
}

.skeleton-line,
.skeleton-switch {
  background: linear-gradient(90deg, #eef2f8 25%, #f8fbff 50%, #eef2f8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line.strong {
  width: 180rpx;
}

.skeleton-line.short {
  width: 120rpx;
  margin-top: 16rpx;
}

.skeleton-switch {
  width: 84rpx;
  height: 46rpx;
  margin-left: 24rpx;
  border-radius: 999rpx;
}

.plan-time {
  font-size: 30rpx;
  font-weight: 700;
  color: #1b2a3d;
}

.plan-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7b8ca3;
}

.empty-state {
  padding: 42rpx 0 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #93a1b3;
}

.ghost-action {
  margin-top: 24rpx;
  border-radius: 22rpx;
  background: #eef3fb;
  color: #2c6ef0;
  font-size: 28rpx;
  font-weight: 600;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}
