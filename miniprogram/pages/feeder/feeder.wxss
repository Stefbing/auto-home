page {
  background: #f2f4f8;
}

.page {
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

/* ========== 顶部导航栏 ========== */
.header-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #ffffff;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.back-icon {
  font-size: 48rpx;
  color: #1677ff;
  font-weight: 300;
  line-height: 1;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.placeholder {
  width: 72rpx;
}

.hero-card,
.card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hero-card {
  margin: 32rpx 32rpx 24rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e8f2ff 100%);
}

.hero-label {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.1);
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #333333;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #666666;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.highlight-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff8ee 100%);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.card-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888888;
}

.pill-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 140, 66, 0.1);
  color: #ff8c42;
  font-size: 22rpx;
  font-weight: 700;
}

.primary-action {
  margin-top: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.25);
}

.primary-action::after,
.ghost-action::after {
  border: none;
}

.primary-action[disabled],
.ghost-action[disabled] {
  opacity: 0.6;
}

.plan-skeleton {
  margin-top: 10rpx;
}

.skeleton-item,
.plan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.skeleton-item:last-child,
.plan-item:last-child {
  border-bottom: none;
}

.skeleton-main {
  flex: 1;
}

.skeleton-line,
.skeleton-switch {
  background: linear-gradient(90deg, #f0f0f0 25%, #f8f8f8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line.strong {
  width: 180rpx;
}

.skeleton-line.short {
  width: 120rpx;
  margin-top: 16rpx;
}

.skeleton-switch {
  width: 84rpx;
  height: 46rpx;
  margin-left: 24rpx;
  border-radius: 999rpx;
}

.plan-time {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.plan-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #888888;
}

.empty-state {
  padding: 42rpx 0 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #888888;
}

.ghost-action {
  margin-top: 24rpx;
  border-radius: 22rpx;
  background: #e8f2ff;
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 600;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}
