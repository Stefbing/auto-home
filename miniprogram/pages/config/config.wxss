.page {
  height: 100vh;
  background: linear-gradient(135deg, #F8FAFC 0%, #E0E7FF 100%);
  padding-bottom: 40rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* Hero卡片 */
.hero-card {
  margin: 24rpx 32rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.hero-icon {
  font-size: 64rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 配置区域 */
.config-section {
  margin: 24rpx 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

/* 配置卡片 */
.config-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #6366F1;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.1);
}

.save-btn {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
  border-radius: 14rpx;
  border: none;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn::after {
  border: none;
}

.save-btn:active:not([disabled]) {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.2);
}

.save-btn[disabled] {
  opacity: 0.7;
}
