/* ======================
   小米体脂秤小程序 - 优化版样式
   基于 UI/UX Pro Max 设计系统
   ====================== */

page {
  background: linear-gradient(180deg, #F8FAFC 0%, #F1F5F9 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ======================
   顶部状态栏
   ====================== */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  position: sticky;
  top: 0;
  z-index: 100;
}

.ble-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  background: #F1F5F9;
  transition: all 0.3s;
}

.ble-badge.scanning {
  background: #EFF6FF;
  animation: pulse-badge 1.5s ease-in-out infinite;
}

.ble-badge.connected {
  background: #ECFDF5;
}

.ble-badge.idle {
  background: #F1F5F9;
}

@keyframes pulse-badge {
0%, 100% { opacity: 1; transform: scale(1); }
50% { opacity: 0.7; transform: scale(0.98); }
}

.ble-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #94A3B8;
  transition: all 0.3s;
}

.ble-badge.scanning .ble-dot {
  background: #3B82F6;
  animation: blink 1s ease-in-out infinite;
}

.ble-badge.connected .ble-dot {
  background: #10B981;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.5);
}

@keyframes blink {
0%, 100% { opacity: 1; }
50% { opacity: 0.3; }
}

.ble-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
}

.rssi-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 100rpx;
  border: 1rpx solid #E2E8F0;
}

.rssi-icon {
  font-size: 20rpx;
}

.rssi-text {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
}

/* ======================
   Hero 设备卡片
   ====================== */
.hero-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.12),
    0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  transition: all 0.3s;
}

.hero-card.pulse {
  animation: hero-pulse 1.5s ease-in-out infinite;
}

@keyframes hero-pulse {
0%, 100% { transform: scale(1); box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.12); }
50% { transform: scale(0.995); box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.08); }
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.device-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.device-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.device-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

.device-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D1D5DB;
  transition: all 0.3s;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.8);
}

.status-dot.connected {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 0 12rpx rgba(16, 185, 129, 0.5);
}

.status-dot.success {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  box-shadow: 0 0 12rpx rgba(59, 130, 246, 0.5);
}

.status-text {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

/* ======================
   重置控制区域
   ====================== */
.reset-controls {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  animation: slide-in 0.3s ease-out;
}

@keyframes slide-in {
  from {
    opacity: 0;
    transform: translateX(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.countdown-badge {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.countdown-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #F59E0B;
  line-height: 1;
}

.countdown-unit {
  font-size: 20rpx;
  color: #9CA3AF;
  font-weight: 500;
}

.control-buttons {
  display: flex;
  gap: 8rpx;
}

.btn-cancel,
.btn-reset {
  padding: 8rpx 16rpx !important;
  font-size: 22rpx !important;
  border-radius: 12rpx !important;
  border: none !important;
  line-height: 1.4 !important;
  min-width: auto !important;
}

.btn-cancel {
  background: #F3F4F6 !important;
  color: #6B7280 !important;
}

.btn-cancel::after {
  border: none !important;
}

.btn-reset {
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%) !important;
  color: #FFFFFF !important;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
}

.btn-reset::after {
  border: none !important;
}

.reset-hint {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
  text-align: center;
  margin-top: 4rpx;
}

.action-buttons {
  flex-shrink: 0;
}

/* 重置按钮 - 完全参考其他二级页面 */
.reset-btn {
  padding: 0 8rpx;
  min-width: 64rpx;
  max-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 14rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s;
  flex-shrink: 0;
}

.reset-btn::after {
  border: none;
}

.reset-btn:active:not([disabled]) {
  background: rgba(37, 99, 235, 0.15);
  transform: scale(0.96);
}

.refresh-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.refresh-btn::after {
  border: none;
}

.refresh-btn:active {
  transform: scale(0.92);
  background: #FFFFFF;
}

.refresh-icon {
  font-size: 32rpx;
  color: #475569;
  font-weight: 700;
}


/* ======================
   体重仪表盘
   ====================== */
.gauge-section {
  margin: 0 32rpx 32rpx;
}

.gauge-card {
  background: #FFFFFF;
  padding: 16rpx 0;
  border-radius: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04),
    0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  display: flex;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.gauge-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.03) 0%, transparent 70%);
  pointer-events: none;
}

.gauge-viewport {
  position: relative;
  width: 480rpx;
  height: 280rpx;
  overflow: hidden;
}

.gauge-container {
  position: absolute;
  width: 480rpx;
  height: 480rpx;
  top: 0;
  left: 0;
  border-radius: 50%;
  border-top: 2rpx solid #F1F5F9;
}

.tick {
  position: absolute;
  left: 240rpx;
  top: 0;
  transform-origin: center 240rpx;
  background: #E2E8F0;
}

.tick.minor { width: 1rpx; height: 12rpx; opacity: 0.5; }
.tick.mid { width: 2rpx; height: 24rpx; background: #CBD5E1; }
.tick.major { width: 4rpx; height: 36rpx; background: #94A3B8; }

.gauge-labels {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.label-item {
  position: absolute;
  font-size: 24rpx;
  color: #94A3B8;
  font-weight: 700;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}

.l-0 { left: 40rpx; top: 240rpx; transform: translateY(-50%); }
.l-75 { left: 50%; top: 40rpx; transform: translateX(-50%); }
.l-150 { right: 36rpx; top: 240rpx; transform: translateY(-50%); }

.needle-layer {
  position: absolute;
  width: 480rpx;
  height: 480rpx;
  top: 0;
  left: 0;
  z-index: 10;
  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.needle-blade {
  position: absolute;
  top: 16rpx;
  left: 50%;
  width: 8rpx;
  height: 144rpx;
  background: linear-gradient(to bottom, #F43F5E 0%, rgba(244, 63, 94, 0) 100%);
  transform: translateX(-50%);
  clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
  filter: drop-shadow(0 0 9rpx rgba(244, 63, 94, 0.4));
}

.data-hub {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
}

.weight-box {
  display: flex;
  align-items: baseline;
  transition: all 0.3s;
}

.weight-box.stable .weight-value {
  color: #10B981;
  text-shadow: 0 0 30rpx rgba(16, 185, 129, 0.2);
}

.weight-box.breathing {
  animation: weight-breathe 2s ease-in-out infinite;
}

@keyframes weight-breathe {
0%, 100% { transform: scale(1); opacity: 1; }
50% { transform: scale(1.02); opacity: 0.95; }
}

.weight-value {
  font-size: 80rpx;
  font-weight: 800;
  color: #1E293B;
  line-height: 1;
  letter-spacing: -4rpx;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.weight-unit {
  font-size: 30rpx;
  font-weight: 600;
  color: #94A3B8;
  margin-left: 12rpx;
}

/* 稳定性进度条（新） */
.stability-progress-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  width: 100%;
}

.progress-track {
  width: 80%;
  height: 8rpx;
  background: #E2E8F0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 4rpx;
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 8rpx rgba(59, 130, 246, 0.3);
}

.progress-text {
  font-size: 24rpx;
  color: #3B82F6;
  font-weight: 600;
}

/* 状态药丸 */
.status-pill {
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  transition: all 0.3s;
  background: #F1F5F9;
  color: #64748B;
}

.pill-scan {
  /* 统一样式，不强调 */
}

.pill-stable {
  /* 统一样式，不强调 */
}

.pill-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.6;
}

.breathing-dot {
  animation: dot-breathe 1.5s ease-in-out infinite;
}

@keyframes dot-breathe {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.8); }
}

/* 阻抗显示 */
.impedance-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  background: #F1F5F9;
  border-radius: 100rpx;
  transition: all 0.3s;
}

.impedance-display.stabilized {
  /* 统一样式，不强调 */
}

.impedance-label {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.impedance-display.stabilized .impedance-label {
  /* 统一样式，不强调 */
}

/* ======================
   自动匹配提示
   ====================== */
.match-toast {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.1);
  border: 2rpx solid #BFDBFE;
  opacity: 0;
  transform: translateY(-20rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.match-toast.show {
  opacity: 1;
  transform: translateY(0);
}

.match-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.match-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.match-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E40AF;
}

.match-confidence {
  font-size: 22rpx;
  color: #3B82F6;
  font-weight: 500;
}

.match-change {
  font-size: 24rpx;
  color: #3B82F6;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* ======================
   家庭成员选择
   ====================== */
.member-section {
  margin: 0 32rpx 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.member-section.fade-in {
  opacity: 1;
  transform: translateY(0);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.auto-match-hint {
  font-size: 22rpx;
  color: #3B82F6;
  font-weight: 600;
  padding: 6rpx 16rpx;
  background: #EFF6FF;
  border-radius: 100rpx;
}

.add-member-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563EB;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all 0.3s;
}

.add-member-btn::after {
  border: none;
}

.add-member-btn:active {
  background: rgba(37, 99, 235, 0.15);
  transform: scale(0.92);
}

.add-member-btn .iconfont {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.member-list {
  white-space: nowrap;
  padding: 0 4rpx;
}

.member-card {
  display: inline-flex;
  align-items: center;
  width: calc((100% - 32rpx) / 3);
  padding: 16rpx 12rpx;
  margin-right: 16rpx;
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  position: relative;
  gap: 12rpx;
}

.member-card:last-child {
  margin-right: 0;
}

.member-card.active {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  box-shadow: 0 4rpx 20rpx rgba(59, 130, 246, 0.15),
    0 0 0 2rpx #3B82F6 inset;
  transform: translateY(-4rpx);
}

.member-card.matched {
  box-shadow: 0 4rpx 20rpx rgba(16, 185, 129, 0.15),
    0 0 0 2rpx #10B981 inset;
}

.member-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.avatar-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.member-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.member-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.info-item {
  font-size: 18rpx;
  color: #64748B;
  font-weight: 500;
}

.info-divider {
  font-size: 16rpx;
  color: #CBD5E1;
}

.member-stats {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.member-weight {
  font-size: 20rpx;
  color: #3B82F6;
  font-weight: 700;
}

.member-time {
  font-size: 16rpx;
  color: #94A3B8;
}

.match-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  padding: 2rpx 8rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 100rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.match-badge text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ======================
   身体评分
   ====================== */
.score-section {
  margin: 0 32rpx 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.score-section.fade-in {
  opacity: 1;
  transform: translateY(0);
}

.score-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.score-ring {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.score-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.score-track {
  fill: none;
  stroke: #E2E8F0;
  stroke-width: 8;
}

.score-bar {
  fill: none;
  stroke: var(--score-color, #10B981);
  stroke-width: 8;
  stroke-linecap: round;
  stroke-dasharray: 326.73;
  transition: stroke-dashoffset 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.score-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-value {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--score-color, #10B981);
  line-height: 1;
}

.score-label {
  font-size: 20rpx;
  color: #94A3B8;
  font-weight: 500;
  margin-top: 4rpx;
}

.score-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-grade {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
}

.score-compare {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

/* ======================
   健康数据统计
   ====================== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 0 32rpx 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.stats-grid.fade-in {
  opacity: 1;
  transform: translateY(0);
}

.stat-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
    0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.stat-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.stat-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
  line-height: 1;
  letter-spacing: 0.5rpx;
}

.stat-unit {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
}

.stat-range {
  font-size: 20rpx;
  color: #94A3B8;
  font-weight: 500;
  margin-top: 4rpx;
}

/* 正常范围 */
.stat-range.normal,
.stat-number.normal {
  color: #10B981;
  font-weight: 600;
}

/* 偏低/偏瘦 */
.stat-range.low,
.stat-number.low {
  color: #F59E0B;
  font-weight: 600;
}

/* 偏高/超重 */
.stat-range.high,
.stat-number.high {
  color: #F97316;
  font-weight: 600;
}

/* 严重偏高/肥胖 */
.stat-range.very-high,
.stat-number.very-high {
  color: #EF4444;
  font-weight: 700;
}

/* 偏瘦（BMI）*/
.stat-range.underweight,
.stat-number.underweight {
  color: #F59E0B;
  font-weight: 600;
}

/* 偏胖（BMI）*/
.stat-range.overweight,
.stat-number.overweight {
  color: #F97316;
  font-weight: 600;
}

/* 肥胖（BMI）*/
.stat-range.obese,
.stat-number.obese {
  color: #EF4444;
  font-weight: 700;
}

/* ======================
   健康建议
   ====================== */
.advice-section {
  margin: 0 32rpx 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.advice-section.fade-in {
  opacity: 1;
  transform: translateY(0);
}

.advice-card {
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.advice-card.normal {
  background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
  border: 2rpx solid #A7F3D0;
}

.advice-card.warning {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 2rpx solid #FDE68A;
}

.advice-card.danger {
  background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
  border: 2rpx solid #FECACA;
}

.advice-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.advice-icon {
  font-size: 36rpx;
}

.advice-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

.advice-body {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.advice-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #374151;
  font-weight: 500;
}

.advice-footer {
  display: flex;
  justify-content: flex-end;
}

.advice-time {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
}

/* ======================
   保存状态
   ====================== */
.save-section {
  margin: 0 32rpx 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.save-section.fade-in {
  opacity: 1;
  transform: translateY(0);
}

.save-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  background: #F1F5F9;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.save-card.saving {
  background: #EFF6FF;
}

.save-card.saved {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
}

.save-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.save-icon {
  font-size: 32rpx;
  color: #059669;
  font-weight: 700;
}

.save-text {
  font-size: 28rpx;
  color: #475569;
  font-weight: 600;
}

.save-card.saved .save-text {
  color: #065F46;
}

/* ======================
   重置提示
   ====================== */
.reset-section {
  margin: 0 32rpx 32rpx;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.reset-section.fade-in {
  opacity: 1;
  transform: translateY(0);
}

.reset-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(245, 158, 11, 0.15),
    0 0 0 2rpx rgba(251, 191, 36, 0.3) inset;
}

.reset-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.reset-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.reset-text-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reset-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #92400E;
}

.reset-desc {
  font-size: 24rpx;
  color: #B45309;
  font-weight: 500;
}

/* ======================
   空状态
   ====================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  margin: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #64748B;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
}

.empty-btn::after {
  border: none;
}

/* ======================
   弹窗
   ====================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.modal-box {
  width: 640rpx;
  max-width: 90vw;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.2),
    0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  animation: modalSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalSlideUp {
from {
opacity: 0;
transform: translateY(80rpx) scale(0.9);
}
to {
opacity: 1;
transform: translateY(0) scale(1);
}
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
  text-align: center;
  margin-bottom: 36rpx;
  letter-spacing: 0.5rpx;
}

.modal-form {
  padding: 40rpx 36rpx 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-group.half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.required {
  color: #EF4444;
  font-weight: 700;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  padding: 0 24rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #10B981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.1);
}

.picker-value {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  padding: 0 24rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  color: #1E293B;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-value:active {
  background: #FFFFFF;
  border-color: #10B981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.1);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 20rpx;
  border: none;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

/* ======================
   调试面板
   ====================== */
.debug-panel {
  margin: 32rpx;
  padding: 24rpx;
  background: #1E293B;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.debug-panel text {
  font-size: 22rpx;
  color: #94A3B8;
  font-family: 'Courier New', monospace;
}

/* ======================
   通用动画
   ====================== */
.fade-in {
  animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes fadeInUp {
from {
opacity: 0;
transform: translateY(30rpx);
}
to {
opacity: 1;
transform: translateY(0);
}
}

@keyframes fadeIn {
from { opacity: 0; }
to { opacity: 1; }
}
