page {
  background: #f2f4f8;
}

.page {
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

/* ========== 顶部导航栏 ========== */
.header-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #ffffff;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.back-icon {
  font-size: 48rpx;
  color: #1677ff;
  font-weight: 300;
  line-height: 1;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.placeholder {
  width: 72rpx;
}

.hero-card,
.status-card,
.card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hero-card {
  margin: 32rpx 32rpx 24rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e8f2ff 100%);
}

.hero-label {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.1);
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #333333;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #666666;
}

.status-card {
  margin-bottom: 24rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  background: linear-gradient(135deg, #1f2a3d 0%, #2c3e50 100%);
}

.status-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.weight-display {
  margin-top: 22rpx;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}

.unit {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.status-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.device-chip {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 22rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.button-stack {
  margin-top: 24rpx;
}

.primary-action,
.secondary-action,
.upload-action,
.mini-action {
  border-radius: 22rpx;
  font-weight: 600;
}

.primary-action::after,
.secondary-action::after,
.upload-action::after,
.mini-action::after {
  border: none;
}

.primary-action {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #ffffff;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.25);
}

.secondary-action {
  margin-top: 16rpx;
  background: #e8f2ff;
  color: #1677ff;
  font-size: 28rpx;
}

.picker-text,
.name-input {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f2f4f8;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
}

.current-user {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e8f2ff 0%, #f0f7ff 100%);
  display: flex;
  align-items: center;
}

.user-label {
  font-size: 26rpx;
  color: #666;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1677ff;
}

.new-user {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.name-input {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
}

.mini-action {
  margin: 0;
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 26rpx;
}

.upload-action {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%);
  color: #ffffff;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(250, 140, 22, 0.25);
}

.empty-log {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #888888;
}

.log-item {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f2f4f8;
  font-size: 22rpx;
  line-height: 1.6;
  color: #666666;
}
