/* 全局页面样式 - UI/UX Pro Max 设计系统 */
page {
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ========== Hero卡片 - 设备状态 ========== */
.hero-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.08),
              0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.device-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.device-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.device-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

.device-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.8);
}

.status-dot.broadcasting {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  box-shadow: 0 0 8rpx rgba(245, 158, 11, 0.4);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.status-dot.connected {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.4);
}

.status-dot.disconnected {
  background: #D1D5DB;
}

.status-text {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.refresh-btn {
  padding: 0 8rpx;
  min-width: 64rpx;
  max-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 14rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s;
  flex-shrink: 0;
}

.refresh-btn::after {
  border: none;
}

.refresh-btn:active:not([disabled]) {
  background: rgba(37, 99, 235, 0.15);
  transform: scale(0.96);
}

.refresh-btn[disabled] {
  opacity: 0.6;
}

.debug-btn {
  padding: 0 8rpx;
  min-width: 64rpx;
  max-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 14rpx;
  background: rgba(245, 158, 11, 0.08);
  color: #F59E0B;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s;
  flex-shrink: 0;
}

.debug-btn::after {
  border: none;
}

.debug-btn:active {
  background: rgba(245, 158, 11, 0.15);
  transform: scale(0.96);
}

/* ========== 实时体重显示 ========== */
.weight-hero {
  margin: 0 32rpx 24rpx;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.weight-value {
  font-size: 120rpx;
  font-weight: 700;
  color: #1E293B;
  line-height: 1;
  letter-spacing: -4rpx;
  display: inline-block;
}

.weight-unit {
  font-size: 36rpx;
  font-weight: 500;
  color: #64748B;
  margin-left: 8rpx;
}

.weight-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.weight-status.stabilized {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.status-icon {
  font-size: 28rpx;
  color: #64748B;
  font-weight: 700;
}

.weight-status.stabilized .status-icon {
  color: #FFFFFF;
}

.status-text {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.weight-status.stabilized .status-text {
  color: #FFFFFF;
}

/* ========== 历史趋势图表 ========== */
.chart-section {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.chart-count {
  font-size: 24rpx;
  color: #94A3B8;
  font-weight: 500;
}

.chart-container {
  margin-top: 24rpx;
  padding: 24rpx 0;
  width: 100%;
}

.weight-chart {
  width: 100%;
  height: 400rpx;
}

/* ========== 实时体脂指标 ========== */
.realtime-metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.3);
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.metric-label {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

/* 容器卡片：清爽白背景 */
.gauge-card {
  background: #FFFFFF;
  margin: 32rpx;
  padding: 80rpx 0 60rpx;
  border-radius: 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: center;
}

/* 视口：关键在于 overflow: hidden 裁切下半圆 */
.gauge-viewport {
  position: relative;
  width: 600rpx;
  height: 380rpx; /* 露出的半圆区域 */
  overflow: hidden;
}

/* 基础容器：600x600 正圆 */
.gauge-container {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  top: 0;
  left: 0;
  border-radius: 50%;
  border-top: 2rpx solid #F1F5F9; /* 极细的外圆弧轮廓 */
}

/* 刻度线：旋转中心严格设在中心点 (300rpx) */
.tick {
  position: absolute;
  left: 300rpx;
  top: 0;
  transform-origin: center 300rpx;
  background: #E2E8F0;
}
.tick.minor { width: 1rpx; height: 12rpx; opacity: 0.5; }
.tick.mid { width: 2rpx; height: 24rpx; background: #CBD5E1; }
.tick.major { width: 4rpx; height: 36rpx; background: #94A3B8; }

/* 刻度数字：不再随圆旋转，而是固定位置 */
.gauge-labels {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}
.label-item {
  position: absolute;
  font-size: 24rpx;
  color: #94A3B8;
  font-weight: 700;
  font-family: Arial, sans-serif;
}
.l-0 { left: 45rpx; top: 300rpx; transform: translateY(-50%); }
.l-75 { left: 50%; top: 50rpx; transform: translateX(-50%); }
.l-150 { right: 45rpx; top: 300rpx; transform: translateY(-50%); }

/* 指针层：同样共享 600rpx 圆心 */
.needle-layer {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  top: 0;
  left: 0;
  z-index: 10;
  transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* 三菱指针形状：严格复刻 HTML 里的渐变和光影 */
.needle-blade {
  position: absolute;
  top: 20rpx;
  left: 50%;
  width: 10rpx;
  height: 180rpx;
  background: linear-gradient(to bottom, #F43F5E 0%, rgba(244, 63, 94, 0) 100%);
  transform: translateX(-50%);
  clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
  filter: drop-shadow(0 0 8rpx rgba(244, 63, 94, 0.4));
}

/* 数据区域：嵌套在圆弧中心下方 */
.data-hub {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
}

.weight-box {
  display: flex;
  align-items: baseline;
  margin-bottom: 4rpx;
}

.weight-value {
  font-size: 104rpx; /* 大数字重心 */
  font-weight: 800;
  color: #1E293B;
  font-family: "DIN Alternate", -apple-system, sans-serif;
  letter-spacing: -2rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.weight-unit {
  font-size: 32rpx;
  font-weight: 700;
  color: #94A3B8;
  margin-left: 12rpx;
}

/* 稳定状态视觉增强 */
.weight-box.stable .weight-value {
  color: #10B981;
  text-shadow: 0 0 20rpx rgba(16, 185, 129, 0.2);
  transition: color 0.3s;
}

/* 状态标签：药丸形呼吸灯 */
.status-pill {
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 32rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.pill-scan { color: #3B82F6; background: #EFF6FF; }
.pill-stable { color: #10B981; background: #ECFDF5; }

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 12rpx;
}

.pill-scan .dot {
  animation: breathe 1.5s infinite ease-in-out;
}

@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1.1); }
  50% { opacity: 0.3; transform: scale(0.8); }
}

/* ========== 家庭成员选择 ========== */
.member-section {
  margin: 0 32rpx 24rpx;
}

.loading-members {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

.add-member-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563EB;
  border: none;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.add-member-btn::after {
  border: none;
}

.add-member-btn .iconfont {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.add-member-btn:active {
  background: rgba(37, 99, 235, 0.15);
  transform: scale(0.92);
}

.member-list {
  white-space: nowrap;
  padding: 16rpx 8rpx;
}

.member-card {
  display: inline-block;
  width: 160rpx;
  padding: 28rpx 16rpx 24rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  text-align: center;
  transition: all 0.3s;
  vertical-align: top;
  box-sizing: border-box;
}

.member-card:last-child {
  margin-right: 0;
}

.member-card.active {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.15),
              0 0 0 2rpx #3B82F6 inset;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 0 auto 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.member-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.info-item {
  font-size: 20rpx;
  color: #64748B;
  font-weight: 500;
}

.info-divider {
  font-size: 18rpx;
  color: #CBD5E1;
}

.member-stats {
  margin-top: 8rpx;
}

.member-weight {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
}

.member-trend {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 6rpx 12rpx;
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  border-radius: 12rpx;
}

.trend-icon {
  font-size: 20rpx;
}

.trend-count {
  font-size: 20rpx;
  color: #3B82F6;
  font-weight: 600;
}

/* ========== 健康数据统计 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 0 32rpx 24rpx;
}

.stat-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.stat-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.stat-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #1E293B;
  line-height: 1;
  letter-spacing: 0.5rpx;
}

.stat-unit {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
}

.stat-range {
  font-size: 20rpx;
  color: #94A3B8;
  font-weight: 500;
  margin-top: 4rpx;
}

/* ========== 快捷操作卡片 ========== */
.action-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
}

.saved-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.15);
}

.saved-icon {
  font-size: 32rpx;
  color: #059669;
  font-weight: 700;
}

.saved-text {
  font-size: 28rpx;
  color: #065F46;
  font-weight: 600;
}

.upload-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 20rpx;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3),
              0 0 0 1rpx rgba(255, 255, 255, 0.2) inset;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-btn::after {
  border: none;
}

.upload-btn:active:not([disabled]) {
  transform: translateY(-2rpx) scale(0.98);
  box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.35);
}

.upload-btn[disabled] {
  opacity: 0.7;
}

.upload-icon {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.upload-text {
  line-height: 1;
}

/* ========== 健康建议卡片 ========== */
.advice-card {
  margin: 0 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(251, 191, 36, 0.15);
}

.card-header {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
  letter-spacing: 0.5rpx;
}

.advice-content {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}

.advice-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #92400E;
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 600rpx;
  max-width: 85vw;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2),
              0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  animation: modalSlideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: 0.5rpx;
}

.modal-form {
  padding: 40rpx 32rpx 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-group.half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.required {
  color: #EF4444;
  font-weight: 700;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #10B981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.1);
}

.picker-value {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  color: #1E293B;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-value:active {
  background: #FFFFFF;
  border-color: #10B981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.1);
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 14rpx;
  border: none;
  margin-top: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

/* ========== 淡入动画 ========== */
.fade-in {
  animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
