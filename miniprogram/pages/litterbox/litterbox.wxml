<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header">
    <view class="title">PetKit 猫厕所</view>
    <button 
      class="refresh-btn" 
      bindtap="refreshData" 
      loading="{{loading}}"
    >
      {{loading ? '刷新中...' : '刷新'}}
    </button>
  </view>

  <!-- 设备控制 -->
  <view class="card">
    <view class="section-title">设备控制</view>
    <button 
      type="warn" 
      bindtap="cleanNow" 
      disabled="{{loading}}"
      loading="{{loading}}"
    >
      {{loading ? '操作中...' : '立即清理'}}
    </button>
  </view>

  <!-- 今日数据 -->
  <view class="card">
    <view class="section-title">今日数据</view>
    <view class="stat-row">
      <text class="label">如厕次数</text>
      <text class="value">{{stats.today_visits}}次</text>
    </view>
    <view class="stat-row">
      <text class="label">平均时长</text>
      <text class="value">{{stats.avg_duration || 0}}秒</text>
    </view>
    <view class="stat-row" wx:if="{{stats.last_pet_weight}}">
      <text class="label">最近猫重</text>
      <text class="value">{{stats.last_pet_weight}}kg</text>
    </view>
  </view>

  <!-- 状态信息 -->
  <view class="card">
    <view class="section-title">设备状态</view>
    <view class="stat-row">
      <text class="label">猫砂余量</text>
      <text class="value">{{stats.sand_percent || 0}}%</text>
    </view>
    <view class="stat-row">
      <text class="label">除臭液剩余</text>
      <text class="value">{{stats.deodorant_days || 0}}天</text>
    </view>
    <view class="stat-row" wx:if="{{stats.frequent_restroom !== undefined}}">
      <text class="label">频繁如厕</text>
      <text class="value" style="color: {{stats.frequent_restroom ? '#ff4d4f' : '#52c41a'}}">{{stats.frequent_restroom ? '有 ⚠️' : '无'}}</text>
    </view>
    <view class="stat-row" wx:if="{{stats.box_full !== undefined}}">
      <text class="label">集便盒</text>
      <text class="value" style="color: {{stats.box_full ? '#ff4d4f' : '#52c41a'}}">{{stats.box_full ? '已满 ⚠️' : '正常'}}</text>
    </view>
  </view>

  <!-- 数据说明 -->
  <view class="info-card" wx:if="{{stats.warning}}">
    <text class="info-text">⚠️ {{stats.warning}}</text>
  </view>
</view>
