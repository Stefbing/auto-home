<view class="page">
  <view class="hero-card">
    <view class="hero-main">
      <view>
        <view class="hero-label">PetKit Monitor</view>
        <view class="hero-title">智能猫砂盆</view>
        <view class="hero-desc">{{stats.device_name || '设备在线状态与清理数据总览'}}</view>
      </view>
      <button class="refresh-btn" bindtap="refreshData" loading="{{refreshing}}" disabled="{{refreshing}}">
        {{refreshing ? '刷新中' : '刷新'}}
      </button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-stack">
    <view class="stats-grid">
      <view class="stat-card skeleton-card" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
        <view class="skeleton-line mini"></view>
        <view class="skeleton-line large"></view>
        <view class="skeleton-line small"></view>
      </view>
    </view>

    <view class="card skeleton-panel">
      <view class="skeleton-line medium"></view>
      <view class="skeleton-line wide"></view>
      <view class="skeleton-badge-row" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="skeleton-line medium"></view>
        <view class="skeleton-chip"></view>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-label">今日如厕</view>
        <view class="stat-number">{{stats.today_visits || 0}}</view>
        <view class="stat-unit">次</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">平均时长</view>
        <view class="stat-number">{{stats.avg_duration || 0}}</view>
        <view class="stat-unit">秒</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">最近体重</view>
        <view class="stat-number">{{stats.last_pet_weight || 0}}</view>
        <view class="stat-unit">kg</view>
      </view>
      <view class="stat-card">
        <view class="stat-label">猫砂余量</view>
        <view class="stat-number">{{stats.sand_percent || 0}}</view>
        <view class="stat-unit">%</view>
      </view>
    </view>

    <view class="card action-card">
      <view class="section-title">设备操作</view>
      <view class="section-desc">把高频操作独立展示，避免误触和信息拥挤。</view>
      <button class="danger-action" bindtap="cleanNow" disabled="{{actionLoading}}" loading="{{actionLoading}}">
        {{actionLoading ? '处理中' : '立即清理'}}
      </button>
    </view>

    <view class="card detail-card">
      <view class="section-title">状态详情</view>
      <view class="detail-row detail-highlight">
        <text class="detail-label">除臭液剩余</text>
        <text class="detail-value">{{stats.deodorant_days || 0}} 天</text>
      </view>
      <view class="detail-row" wx:if="{{stats.frequent_restroom !== undefined}}">
        <text class="detail-label">频繁如厕</text>
        <text class="detail-badge {{stats.frequent_restroom ? 'danger' : 'safe'}}">
          {{stats.frequent_restroom ? '需关注' : '正常'}}
        </text>
      </view>
      <view class="detail-row" wx:if="{{stats.box_full !== undefined}}">
        <text class="detail-label">集便仓</text>
        <text class="detail-badge {{stats.box_full ? 'danger' : 'safe'}}">
          {{stats.box_full ? '已满' : '正常'}}
        </text>
      </view>
    </view>

    <view class="info-card" wx:if="{{stats.warning}}">
      <view class="info-title">提醒</view>
      <text class="info-text">{{stats.warning}}</text>
    </view>
  </block>
</view>
