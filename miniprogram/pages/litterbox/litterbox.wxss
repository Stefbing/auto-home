page {
  background: #f4f7fb;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-card,
.card,
.info-card,
.stat-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 36rpx rgba(20, 40, 80, 0.06);
}

.hero-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eefaf4 100%);
}

.hero-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-label {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(36, 170, 102, 0.12);
  color: #17995c;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #142437;
}

.hero-desc {
  margin-top: 12rpx;
  max-width: 420rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #66788f;
}

.refresh-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #1f7aeb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.refresh-btn::after,
.danger-action::after {
  border: none;
}

.refresh-btn[disabled] {
  opacity: 0.88;
}

.loading-stack {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-card {
  width: 48%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.skeleton-card,
.skeleton-panel {
  overflow: hidden;
}

.skeleton-line,
.skeleton-chip {
  background: linear-gradient(90deg, #eef2f8 25%, #f8fbff 50%, #eef2f8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line.mini {
  width: 110rpx;
}

.skeleton-line.small {
  width: 90rpx;
  margin-top: 16rpx;
}

.skeleton-line.medium {
  width: 180rpx;
}

.skeleton-line.large {
  width: 150rpx;
  height: 54rpx;
  margin-top: 22rpx;
}

.skeleton-line.wide {
  width: 260rpx;
  margin-top: 24rpx;
}

.skeleton-panel {
  padding: 30rpx;
}

.skeleton-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.skeleton-chip {
  width: 108rpx;
  height: 48rpx;
  border-radius: 999rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #7b8aa0;
}

.stat-number {
  margin-top: 18rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
  color: #152335;
}

.stat-unit {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a99ad;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
}

.action-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff4f1 100%);
}

.detail-card {
  background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #172639;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7c8ca2;
}

.danger-action {
  margin-top: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff6a5f 0%, #ff8d72 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f5;
}

.detail-highlight {
  margin-top: 10rpx;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #5d6f86;
}

.detail-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #172639;
}

.detail-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.detail-badge.safe {
  background: rgba(33, 181, 111, 0.12);
  color: #17995c;
}

.detail-badge.danger {
  background: rgba(255, 98, 87, 0.12);
  color: #e75a4d;
}

.info-card {
  padding: 28rpx;
  background: #fff9eb;
}

.info-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #b97b15;
}

.info-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9a6a12;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}
