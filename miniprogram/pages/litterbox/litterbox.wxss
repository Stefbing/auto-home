page {
  background: #f2f4f8;
}

.page {
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

/* ========== 顶部导航栏 ========== */
.header-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #ffffff;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.back-icon {
  font-size: 48rpx;
  color: #1677ff;
  font-weight: 300;
  line-height: 1;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.placeholder {
  width: 72rpx;
}

.hero-card,
.card,
.info-card,
.stat-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hero-card {
  margin: 32rpx 32rpx 24rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e8f8f0 100%);
}

.hero-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-label {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #333333;
}

.hero-desc {
  margin-top: 12rpx;
  max-width: 420rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #666666;
}

.refresh-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.refresh-btn::after,
.danger-action::after {
  border: none;
}

.refresh-btn[disabled] {
  opacity: 0.6;
}

.loading-stack {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-card {
  width: 48%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.skeleton-card,
.skeleton-panel {
  overflow: hidden;
}

.skeleton-line,
.skeleton-chip {
  background: linear-gradient(90deg, #f0f0f0 25%, #f8f8f8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line.mini {
  width: 110rpx;
}

.skeleton-line.small {
  width: 90rpx;
  margin-top: 16rpx;
}

.skeleton-line.medium {
  width: 180rpx;
}

.skeleton-line.large {
  width: 150rpx;
  height: 54rpx;
  margin-top: 22rpx;
}

.skeleton-line.wide {
  width: 260rpx;
  margin-top: 24rpx;
}

.skeleton-panel {
  padding: 30rpx;
}

.skeleton-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.skeleton-chip {
  width: 108rpx;
  height: 48rpx;
  border-radius: 999rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888888;
}

.stat-number {
  margin-top: 18rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
  color: #333333;
}

.stat-unit {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #888888;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.action-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff4f1 100%);
}

.detail-card {
  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888888;
}

.danger-action {
  margin-top: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.25);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-highlight {
  margin-top: 10rpx;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #666666;
}

.detail-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.detail-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.detail-badge.safe {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.detail-badge.danger {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.info-card {
  padding: 28rpx;
  background: #fffbe6;
}

.info-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #faad14;
}

.info-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #d48806;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}
