/* 全局页面样式 - UI/UX Pro Max 设计系统 */
page {
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
  overflow: hidden;
}

.page {
  height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* ========== Hero卡片 - 设备状态 ========== */
.hero-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.08),
              0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.refresh-btn {
  padding: 0 8rpx;
  min-width: 64rpx;
  max-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 14rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s;
  flex-shrink: 0;
}

.refresh-btn::after {
  border: none;
}

.refresh-btn:active:not([disabled]) {
  background: rgba(37, 99, 235, 0.15);
  transform: scale(0.96);
}

.refresh-btn[disabled] {
  opacity: 0.6;
}

/* ========== Hero卡片 - 设备状态 ========== */
.hero-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.08),
              0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.device-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.device-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.device-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: 0.5rpx;
}

.device-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.8);
}

.status-dot.online {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.4);
}

.status-text {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

/* ========== 数据统计网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 0 32rpx 24rpx;
}

.stat-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.stat-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.visits-card .stat-icon {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
}

.duration-card .stat-icon {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.weight-card .stat-icon {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
}

.sand-card .stat-icon {
  background: linear-gradient(135deg, #FCE7F3 0%, #FBCFE8 100%);
}

.stat-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #1E293B;
  line-height: 1;
  letter-spacing: 0.5rpx;
}

.stat-unit {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
}

/* ========== 加载骨架屏 ========== */
.loading-stack {
  margin: 0 32rpx 24rpx;
}

.skeleton-card,
.skeleton-panel {
  overflow: hidden;
}

.skeleton-line,
.skeleton-chip {
  background: linear-gradient(90deg, #F1F5F9 25%, #E2E8F0 50%, #F1F5F9 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.skeleton-line.mini {
  width: 110rpx;
}

.skeleton-line.small {
  width: 90rpx;
  margin-top: 16rpx;
}

.skeleton-line.medium {
  width: 180rpx;
}

.skeleton-line.large {
  width: 150rpx;
  height: 54rpx;
  margin-top: 22rpx;
}

.skeleton-line.wide {
  width: 260rpx;
  margin-top: 24rpx;
}

.skeleton-panel {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.skeleton-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.skeleton-chip {
  width: 108rpx;
  height: 48rpx;
  border-radius: 999rpx;
}

/* ========== 快捷操作卡片 ========== */
.action-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #94A3B8;
  display: block;
}

.clean-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 20rpx;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3),
              0 0 0 1rpx rgba(255, 255, 255, 0.2) inset;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 1rpx;
}

.clean-btn::after {
  border: none;
}

.clean-btn:active:not([disabled]) {
  transform: translateY(-2rpx) scale(0.98);
  box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.35);
}

.clean-btn[disabled] {
  opacity: 0.7;
}

/* ========== 状态详情卡片 ========== */
.detail-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
}

.detail-list {
  margin-top: 8rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-item.highlight {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.03) 0%, transparent 100%);
  margin: -8rpx -16rpx 8rpx;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  border-bottom: none;
}

.detail-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-icon {
  font-size: 32rpx;
}

.detail-label {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}

.detail-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
}

.detail-value.primary {
  color: #2563EB;
}

.detail-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.detail-badge.safe {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.detail-badge.danger {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

/* ========== 警告卡片 ========== */
.warning-card {
  margin: 0 32rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(251, 191, 36, 0.15);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.warning-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.warning-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.warning-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #D97706;
}

.warning-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #B45309;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
