<view class="page">
  <!-- 未登录状态 - 显示简单登录表单 -->
  <view wx:if="{{!userInfo}}" class="login-container">
    <view class="hero">
      <view class="hero-kicker">AutoHome</view>
      <view class="hero-title">智能家居控制中心</view>
      <view class="hero-desc">登录后即可管理您的智能设备</view>
    </view>

    <view class="login-form">
      <view class="form-item">
        <text class="label">手机号</text>
        <input class="input" type="number" placeholder="请输入手机号" model:value="{{phoneNumber}}" maxlength="11" />
      </view>

      <button class="login-btn" bindtap="onLogin">
        <text>登录 / 注册</text>
      </button>
    </view>
  </view>

  <!-- 已登录但未配置 - 显示配置引导 -->
  <view wx:elif="{{!hasConfigured}}" class="config-guide">
    <view class="hero">
      <view class="hero-kicker">欢迎，{{userInfo.nickname}}</view>
      <view class="hero-title">完成初始配置</view>
      <view class="hero-desc">请输入设备账号密码以启用服务</view>
    </view>

    <view class="config-form">
      <view class="form-item">
        <text class="label">设备账号</text>
        <input class="input" placeholder="例如：86-17757577548" model:value="{{account}}" />
        <text class="hint">PetKit / CloudPets 共用此账号</text>
      </view>

      <view class="form-item">
        <text class="label">密码</text>
        <input class="input" type="password" placeholder="请输入密码" model:value="{{password}}" />
      </view>

      <button class="submit-btn" bindtap="onSubmitConfig">保存配置</button>
    </view>
  </view>

  <!-- 已配置 - 显示正常首页 -->
  <view wx:else>
    <view class="hero">
      <view class="hero-kicker">AutoHome</view>
      <view class="hero-title">智能家居控制中心</view>
      <view class="hero-desc">把宠物照护设备集中到一个更清晰、更轻快的控制面板里。</view>
    </view>

    <view class="section-head">
      <view class="section-title">设备入口</view>
      <view class="section-desc">选择你要管理的设备</view>
    </view>

    <view class="menu-list">
      <navigator url="/pages/feeder/feeder" class="menu-card feeder-card">
        <view class="menu-top">
          <view class="menu-icon">FEED</view>
          <view class="menu-tag">Control</view>
        </view>
        <view class="menu-title">智能喂食器</view>
        <view class="menu-subtitle">PetWant / CloudPets</view>
        <view class="menu-desc">快速投喂、计划切换、日常操作更直接</view>
      </navigator>

      <navigator url="/pages/litterbox/litterbox" class="menu-card litter-card">
        <view class="menu-top">
          <view class="menu-icon">CARE</view>
          <view class="menu-tag">Monitor</view>
        </view>
        <view class="menu-title">智能猫砂盆</view>
        <view class="menu-subtitle">PetKit</view>
        <view class="menu-desc">清理控制、状态监测、今日统计一目了然</view>
      </navigator>

      <navigator url="/pages/scale/scale" class="menu-card scale-card">
        <view class="menu-top">
          <view class="menu-icon">BODY</view>
          <view class="menu-tag">Live</view>
        </view>
        <view class="menu-title">智能体重秤</view>
        <view class="menu-subtitle">Bluetooth Scale</view>
        <view class="menu-desc">实时读数、用户归属、快速上传体重记录</view>
      </navigator>
    </view>
  </view>
</view>
