<view class="page">
  <!-- 未登录状态 - 直接输入 -->
  <view wx:if="{{!userInfo}}" class="login-page">
    <view class="login-content">
      <view class="brand-section">
        <text class="brand-icon">🏠</text>
        <text class="brand-title">我的智能家</text>
        <text class="brand-desc">智能家居控制中心</text>
      </view>
      
      <view class="login-form">
        <view class="input-wrapper">
          <input 
            class="phone-input" 
            type="number" 
            placeholder="请输入手机号" 
            value="{{phoneNumber}}"
            bindinput="onPhoneInput"
            bindconfirm="onLogin"
            maxlength="11"
            focus="{{true}}"
          />
        </view>
        
        <button class="login-btn {{phoneNumber.length === 11 ? 'active' : ''}}" 
                bindtap="onLogin" 
                disabled="{{phoneNumber.length !== 11}}">
          登录 / 注册
        </button>
        
        <text class="login-tip">演示账号：任意11位手机号</text>
      </view>
    </view>
  </view>

  <!-- 已登录 - 设备列表 -->
  <view wx:else class="device-page">
    <!-- 顶部导航 -->
    <view class="page-header">
      <text class="page-title">我的设备</text>
      <button class="add-btn" bindtap="showAddDeviceModal">
        <text class="icon">+</text>
      </button>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{userDevices.length === 0}}" class="empty-state">
      <view class="empty-icon">📱</view>
      <text class="empty-title">暂无设备</text>
      <text class="empty-desc">点击右上角 + 添加你的第一个智能设备</text>
      <button class="add-device-btn" bindtap="showAddDeviceModal">添加设备</button>
    </view>

    <!-- 设备分组列表 -->
    <scroll-view wx:else class="device-scroll" scroll-y>
      <!-- 宠物生活 -->
      <view wx:if="{{petDevices.length > 0}}" class="device-section">
        <view class="section-header">
          <text class="section-icon">🐾</text>
          <text class="section-name">宠物生活</text>
        </view>
        
        <view class="device-cards">
          <block wx:for="{{petDevices}}" wx:key="device_key">
            <navigator wx:if="{{item.device_type === 'feeder'}}" 
                       url="/pages/feeder/feeder" 
                       class="device-card">
              <view class="card-icon" style="background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);">
                <text class="icon-text">🍖</text>
              </view>
              <view class="card-info">
                <text class="card-name">{{item.device_name || '喂食机'}}</text>
                <view class="card-status">
                  <view class="status-dot {{item.status === 'active' ? 'online' : 'offline'}}"></view>
                  <text class="status-text">{{item.status === 'active' ? '在线' : '待配置'}}</text>
                </view>
              </view>
              <text class="card-arrow">›</text>
            </navigator>

            <navigator wx:if="{{item.device_type === 'litterbox'}}" 
                       url="/pages/litterbox/litterbox" 
                       class="device-card">
              <view class="card-icon" style="background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);">
                <text class="icon-text">🚽</text>
              </view>
              <view class="card-info">
                <text class="card-name">{{item.device_name || '猫厕所'}}</text>
                <view class="card-status">
                  <view class="status-dot {{item.status === 'active' ? 'online' : 'offline'}}"></view>
                  <text class="status-text">{{item.status === 'active' ? '在线' : '待配置'}}</text>
                </view>
              </view>
              <text class="card-arrow">›</text>
            </navigator>
          </block>
        </view>
      </view>

      <!-- 健康与体质 -->
      <view wx:if="{{healthDevices.length > 0}}" class="device-section">
        <view class="section-header">
          <text class="section-icon">❤️</text>
          <text class="section-name">健康与体质</text>
        </view>
        
        <view class="device-cards">
          <block wx:for="{{healthDevices}}" wx:key="device_key">
            <navigator wx:if="{{item.device_type === 'scale'}}" 
                       url="/pages/scale/scale" 
                       class="device-card">
              <view class="card-icon" style="background: linear-gradient(135deg, #f6ffed 0%, #d9f7be 100%);">
                <text class="icon-text">⚖️</text>
              </view>
              <view class="card-info">
                <text class="card-name">{{item.device_name || '体脂秤'}}</text>
                <view class="card-status">
                  <view class="status-dot offline"></view>
                  <text class="status-text">蓝牙连接</text>
                </view>
              </view>
              <text class="card-arrow">›</text>
            </navigator>
          </block>
        </view>
      </view>
    </scroll-view>

    <!-- 用户信息 -->
    <view class="user-footer">
      <text class="user-phone">{{userInfo.phone_number}}</text>
      <button class="logout-link" bindtap="logout">退出</button>
    </view>
  </view>

  <!-- 添加设备弹窗 -->
  <view wx:if="{{showAddDeviceDialog}}" class="modal-mask" bindtap="closeAddDeviceModal">
    <view class="modal-box" catchtap="stopPropagation">
      <view class="modal-title">选择设备类型</view>
      
      <view class="device-options">
        <view class="option-item" bindtap="selectDeviceType" data-type="feeder" data-platform="cloudpets">
          <view class="option-icon" style="background: #fff7e6;">🍖</view>
          <text class="option-name">喂食机</text>
        </view>
        
        <view class="option-item" bindtap="selectDeviceType" data-type="litterbox" data-platform="petkit">
          <view class="option-icon" style="background: #e6f7ff;">🚽</view>
          <text class="option-name">猫厕所</text>
        </view>
        
        <view class="option-item" bindtap="selectDeviceType" data-type="scale" data-platform="xiaomi">
          <view class="option-icon" style="background: #f6ffed;">⚖️</view>
          <text class="option-name">体脂秤</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 设备配置弹窗 -->
  <view wx:if="{{showDeviceConfigDialog}}" class="modal-mask" bindtap="closeDeviceConfigModal">
    <view class="modal-box modal-form" catchtap="stopPropagation">
      <view class="modal-title">配置{{selectedDeviceTypeText}}</view>
      
      <view class="form-group">
        <text class="form-label">设备账号</text>
        <input class="form-input" 
               placeholder="请输入账号" 
               value="{{deviceAccount}}"
               bindinput="onAccountInput" />
      </view>
      
      <view class="form-group">
        <text class="form-label">密码</text>
        <input class="form-input" 
               type="password" 
               placeholder="请输入密码" 
               value="{{devicePassword}}"
               bindinput="onPasswordInput" />
      </view>
      
      <button class="submit-btn" bindtap="onSubmitDeviceConfig">确认添加</button>
    </view>
  </view>
</view>
