/* 全局页面样式 - UI/UX Pro Max 设计系统 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
}

/* ========== 登录页 ========== */
.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  padding: 60rpx;
}

.login-content {
  width: 100%;
  max-width: 640rpx;
}

.brand-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.brand-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.1));
}

.brand-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.brand-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

.login-form {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15), 
              0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  box-sizing: border-box;
}

.input-wrapper {
  margin-bottom: 40rpx;
}

.phone-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  padding: 0 24rpx;
  text-align: center;
  background: #F8FAFC;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.phone-input:focus {
  background: #FFFFFF;
  border-color: #3B82F6;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.1);
}

.login-btn {
  width: 80%;
  max-width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  background: linear-gradient(135deg, #CBD5E1 0%, #94A3B8 100%);
  border-radius: 44rpx;
  border: none;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  letter-spacing: 2rpx;
}

.login-btn.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35),
              0 0 0 1rpx rgba(255, 255, 255, 0.3) inset;
  transform: translateY(-2rpx);
  opacity: 1;
}

.login-btn:active {
  transform: translateY(0) scale(0.98);
}

.login-btn::after {
  border: none;
}

.login-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* ========== 设备页 ========== */
.device-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: sticky;
  top: 0;
  z-index: 100;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 1rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 50%;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.add-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.2);
}

.add-btn .icon {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.add-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 32rpx;
  filter: grayscale(0.3);
  opacity: 0.8;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.add-device-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.add-device-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.2);
}

.add-device-btn::after {
  border: none;
}

/* 设备滚动区 */
.device-scroll {
  height: calc(100vh - 240rpx);
  padding: 32rpx 0;
}

/* 设备分组 */
.device-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 0 40rpx 24rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 0.5rpx;
}

.device-cards {
  padding: 0 32rpx;
}

.device-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.device-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.03) 0%, transparent 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.device-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.12),
              0 0 0 1rpx rgba(59, 130, 246, 0.1) inset;
}

.device-card:active::before {
  opacity: 1;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.icon-text {
  font-size: 48rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.card-status {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.8);
}

.status-dot.online {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.4);
}

.status-dot.offline {
  background: #D1D5DB;
}

.status-text {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
}

.card-arrow {
  font-size: 52rpx;
  color: #D1D5DB;
  font-weight: 300;
  margin-left: 12rpx;
  transition: all 0.3s;
}

.device-card:active .card-arrow {
  color: #3B82F6;
  transform: translateX(4rpx);
}

/* 用户底部 */
.user-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 40rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.user-phone {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}

.logout-link {
  font-size: 28rpx;
  color: #EF4444;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1;
  font-weight: 500;
}

.logout-link::after {
  border: none;
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 640rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2),
              0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  animation: modalSlideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}

/* 设备选项网格 */
.device-options {
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
}

.option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
  border-radius: 20rpx;
  background: #F8FAFC;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex: 1;
}

.option-item:active {
  background: rgba(59, 130, 246, 0.08);
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.15);
}

.option-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.option-item:active .option-icon {
  transform: scale(1.05);
}

.option-name {
  font-size: 28rpx;
  color: #374151;
  font-weight: 600;
}

/* 表单弹窗 */
.modal-form {
  padding: 48rpx 40rpx 40rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  padding: 0 24rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #3B82F6;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.1);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 16rpx;
  border: none;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.2);
}

.submit-btn::after {
  border: none;
}
