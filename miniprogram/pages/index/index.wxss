page {
  background: #f4f7fb;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero {
  padding: 40rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eef5ff 100%);
  box-shadow: 0 20rpx 40rpx rgba(31, 66, 135, 0.08);
}

.hero-kicker {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(44, 110, 240, 0.10);
  color: #2c6ef0;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #132238;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #61738b;
}

.section-head {
  margin: 36rpx 4rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #18263a;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7e8ca0;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-card {
  display: block;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(20, 40, 80, 0.06);
}

.menu-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-icon {
  min-width: 108rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  color: #1f3552;
}

.menu-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6b7d95;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.menu-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #152335;
}

.menu-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5c7088;
}

.menu-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #73849a;
}

.feeder-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff6ea 100%);
}

.litter-card {
  background: linear-gradient(135deg, #ffffff 0%, #eefaf4 100%);
}

.scale-card {
  background: linear-gradient(135deg, #ffffff 0%, #edf6ff 100%);
}

/* 登录容器 */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  min-height: 100vh;
}

.login-form {
  margin-top: 60rpx;
  width: 100%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx;
  box-shadow: 0 18rpx 36rpx rgba(20, 40, 80, 0.06);
}

.login-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.3);
}

/* 配置引导 */
.config-guide {
  padding: 40rpx;
  min-height: 100vh;
}

.config-form {
  margin-top: 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx;
  box-shadow: 0 18rpx 36rpx rgba(20, 40, 80, 0.06);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item .label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #18263a;
  font-weight: 500;
}

.form-item .input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  font-size: 28rpx;
  color: #18263a;
}

.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(74, 144, 226, 0.3);
}
