<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <!-- 左侧返回按钮 -->
    <view wx:if="{{showBack}}" class="nav-btn left" bindtap="onBack">
      <text class="btn-icon">‹</text>
    </view>
    
    <!-- 中间标题（可选） -->
    <view wx:if="{{title}}" class="nav-title">{{title}}</view>
    
    <!-- 右侧关闭按钮 -->
    <view wx:if="{{showClose}}" class="nav-btn right" bindtap="onClose">
      <text class="btn-icon">✕</text>
    </view>
  </view>
</view>
